C_STD = C11
PKG_CPPFLAGS = $(KPQC_CPPFLAGS)
PKG_CFLAGS = $(C_VISIBILITY)
PKG_LIBS = -lm

HAETAE_CPPFLAGS = -Ithird_party/HAETAE/include
SMAUGT_CPPFLAGS = -Ithird_party/SMAUG-T/include

all: $(SHLIB)

core_haetae2.o: core_haetae2.c
	$(CC) $(ALL_CPPFLAGS) $(HAETAE_CPPFLAGS) $(ALL_CFLAGS) -c core_haetae2.c -o core_haetae2.o

